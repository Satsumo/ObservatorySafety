<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
      Id="*"
      Name="ObservatorySafety Watchdog"
      Language="1033"
      Version="1.0.0.0"
      Manufacturer="Satsumo"
      UpgradeCode="F8D4B6A1-2C9E-4E7B-8F13-9A6C2D1B7E45">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <!-- REQUIRED ROOT DIRECTORY -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="ObservatorySafety.Watchdog" />
      </Directory>
    </Directory>

    <!-- Main Feature -->
    <Feature Id="MainFeature" Title="ObservatorySafety Watchdog" Level="1">
      <ComponentGroupRef Id="WatchdogComponents" />
      <ComponentRef Id="WatchdogInstaller" />
    </Feature>

    <!-- Windows Service installation -->
    <Component Id="WatchdogInstaller" Directory="INSTALLDIR">

      <!-- Main EXE -->
      <File Id="WatchdogExe"
            Source="$(var.WatchdogExePath)"
            KeyPath="yes" />

      <!-- Include baseline appsettings.json -->
      <File Id="WatchdogConfig"
            Source="$(var.WatchdogConfigPath)"
            Name="appsettings.json" />

      <!-- Install the Windows Service -->
      <ServiceInstall
          Id="ObservatorySafetyWatchdogInstall"
          Name="ObservatorySafety.Watchdog"
          DisplayName="Observatory Safety Watchdog"
          Description="Monitors the ObservatorySafety Service."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Vital="yes"
          Account="LocalSystem" />

      <!-- Control service behaviour during MSI install -->
      <!-- No Start attribute → MSI will NOT start the service -->
      <ServiceControl
          Id="ObservatorySafetyWatchdogControl"
          Name="ObservatorySafety.Watchdog"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />

      <!-- Environment variable -->
      <RegistryValue
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\ObservatorySafety.Watchdog"
          Name="Environment"
          Type="multiString"
          Value="OBSERVATORY_ENVIRONMENT=Production"
          Action="write" />

    </Component>

  </Product>
</Wix>
