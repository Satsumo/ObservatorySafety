<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
      Id="*"
      Name="ObservatorySafety Watchdog"
      Language="1033"
      Version="1.0.0.0"
      Manufacturer="Satsumo"
      UpgradeCode="F8D4B6A1-2C9E-4E7B-8F13-9A6C2D1B7E45">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine" />

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <!-- Install into standard Program Files (x86) -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="ObservatorySafety.Watchdog" />
      </Directory>
    </Directory>

    <!-- Main Feature -->
    <Feature Id="MainFeature" Title="ObservatorySafety Watchdog" Level="1">
      <ComponentGroupRef Id="WatchdogComponents" />
      <ComponentRef Id="WatchdogInstaller" />
      <ComponentRef Id="WatchdogConfigComponent" />
    </Feature>

    <!-- Windows Service installation -->
    <Component Id="WatchdogInstaller"
               Directory="INSTALLDIR">

      <!-- Main EXE -->
      <File Id="WatchdogExe"
            Source="$(var.WatchdogExePath)"
            KeyPath="yes" />

      <ServiceInstall
          Id="ObservatorySafetyWatchdogInstall"
          Name="ObservatorySafety.Watchdog"
          DisplayName="Observatory Safety Watchdog"
          Description="Monitors the ObservatorySafety Service."
          Start="manual"
          Type="ownProcess"
          ErrorControl="normal"
          Vital="yes"
          Account="LocalSystem" />

      <ServiceControl
          Id="ObservatorySafetyWatchdogControl"
          Name="ObservatorySafety.Watchdog"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />

      <RegistryValue
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\ObservatorySafety.Watchdog"
          Name="Environment"
          Type="multiString"
          Value="OBSERVATORY_ENVIRONMENT=Production"
          Action="write" />
    </Component>

    <!-- Overwrite-safe config component -->
    <Component Id="WatchdogConfigComponent"
               Guid="9f92e734-ce38-409f-87c4-33f8c93f337b"
               Directory="INSTALLDIR">

      <!-- Versioned KeyPath -->
      <File Id="WatchdogConfigVersion"
            Source="$(var.WatchdogVersionPath)"
            Name="appsettings.version"
            KeyPath="yes" />

      <!-- Delete old JSON on install -->
      <RemoveFile Id="RemoveOldWatchdogConfig"
                  Name="appsettings.json"
                  On="install"
                  Directory="INSTALLDIR" />

      <!-- New JSON config file -->
      <File Id="WatchdogConfig"
            Source="$(var.WatchdogConfigPath)"
            Name="appsettings.json"
            KeyPath="no" />
    </Component>

  </Product>
</Wix>
