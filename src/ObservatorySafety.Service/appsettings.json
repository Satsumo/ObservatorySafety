{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs\\safety.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Equipment": {
    "MountParkTimeThresholdSeconds": 120,
    "DomeCloseTimeThresholdSeconds": 120
  },
  "CloudWatcher": {
    "Enabled": true,
    "Path": "FULL_PATH_TO_FILE-aag_json.dat",
    "PollingPeriodSeconds": 30,
    "StaleDataThresholdSeconds": 300,
    "MonitoredStatuses": [ "CloudWatcherStale" ]
  },
  "DarkDragon": {
    "Enabled": true,
    "BaseUrl": "http://mountsensor-SERIAL_NUMBER",
    "ApiKey": "",
    "PollingPeriodSeconds": 30,
    "MonitoredStatuses": [ "MountParked" ]
  },
  "Dragonfly": {
    "Enabled": true,
    "AscomID": "Dragonfly.Switch",
    "Sensor": [ "RoofOpened", "RoofClosed", "PowerOn", "WeatherSafe", "MountParked", "ApplicationRunning", "SequenceRunning" ],
    "PollingPeriodSeconds": 30,
    "MonitoredStatuses": [ "RoofClosed", "RoofOpen", "WeatherSafe" ]
  },
  "Nina": {
    "Enabled": true,
    "BaseUrl": "http://localhost:1888",
    "ApiKey": "",
    "PollingPeriodSeconds": 30,
    "MonitoredStatuses": [ "ApplicationRunning", "SequenceRunning" ]
  },
  "Power": {
    "Enabled": true,
    "PollingPeriodSeconds": 10,
    "PowerOutageConfirmedThresholdSeconds": 30,
    "MonitoredStatuses": [ "PowerOn" ]
  },
  "Shutdown": {
    "ShutdownThresholdMinutes": 10,
    "ShutdownTriggerStatuses": [ "WeatherSafe", "RoofClosed" ],
    "AscomProviders": [
      {
        "AscomID": "ASCOM.GS.Sky.Telescope",
        "MonitoredStatuses": [ "MountParked" ],
        "SwitchNames": [ "Park" ]
      },
      {
        "AscomID": "Dragonfly.Dome",
        "MonitoredStatuses": [ "RoofClosed" ],
        "SwitchNames": [ "Close" ]
      }
    ],
    "DelayBetweenSwitchCallsSeconds": 30
  },
  "USBRelaySwitch": {
    "Enabled": true,
    "VendorID": "VENDOR_ID",
    "ProductID": "PRODUCT_ID",
    "BaudRate": 9600,
    "CommandType": "ASCII",
    "StatusProviders": [ "DarkDragonMountSensor", "PowerStatus", "NINA" ],
    "Relays": [ "PowerOn", "MountParked", "ApplicationRunning", "SequenceRunning" ]
  },
  "Alerts": {
    "AlertSuppressionDelayMinutes": 10
  },
  "Pushover": {
    "Enabled": true,
    "UserKey": "YOUR_PUSHOVER_USER_KEY",
    "AppToken": "YOUR_PUSHOVER_APP_TOKEN_HERE"
  },
  "Email": {
    "Enabled": true,
    "SmtpServer": "YOUR_EMAIL_SMTP_PROVIDER_URL",
    "SmtpPort": 587,
    "UseTls": true,
    "Username": "YOUR_EMAIL_ADDRESS",
    "Password": "YOUR_EMAIL_APP_PASSWORD_HERE",
    "From": "YOUR_EMAIL_ADDRESS",
    "To": "EMAIL_ADDRESS_YOU_WANT_ALERT_TO_GO_TO"
  },
  "WhatsApp": {
    "Enabled": true,
    "TwilioSid": "YOUR_TWILIO_SID_HERE",
    "TwilioToken": "YOUR_TWILIO_TOKEN_HERE",
    "FromNumber": "whatsapp:+YOUR_TWILIO_WHATSAPP_NUMBER",
    "ToNumber": "whatsapp:+YOUR_PERSONAL_WHATSAPP_NUMBER"
  }
}